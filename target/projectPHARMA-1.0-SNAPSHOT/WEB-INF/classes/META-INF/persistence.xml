<?xml version="1.0" encoding="UTF-8"?>
<persistence version="3.0" xmlns="https://jakarta.ee/xml/ns/persistence"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="https://jakarta.ee/xml/ns/persistence https://jakarta.ee/xml/ns/persistence/persistence_3_0.xsd">
  <!-- Define Persistence Unit -->
  <persistence-unit name="my_persistence_unit" transaction-type="JTA">
    <jta-data-source>java:/jdbc/PostgresDS</jta-data-source>
    <class>entities.Utilisateur</class>
    <class>entities.Produit</class>
    <class>entities.Vente</class>
    <class>entities.LigneVente</class>
    <class>entities.BonDeCommande</class>
    <class>entities.ConsultationBonCommande</class>
    <class>entities.Echange</class>
    <class>entities.LigneEchange</class>
    <exclude-unlisted-classes>false</exclude-unlisted-classes>
    <properties>
      <!-- "none" pour conserver précieusement les utilisateurs et données sans les vider au déploiement -->
      <property name="jakarta.persistence.schema-generation.database.action" value="update"/>
      <property name="hibernate.dialect" value="org.hibernate.dialect.PostgreSQLDialect"/>
    </properties>
  </persistence-unit>
</persistence>
